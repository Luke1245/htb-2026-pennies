# Copy this file to .env.local. Vite reads .env.local and does not commit it.

VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=

# Identifier of the Auth0 API. Must match AUTH0_AUDIENCE in backend/.env.
# Leave unset until that API exists. Login still works without it.
# VITE_AUTH0_AUDIENCE=https://your-api-identifier
