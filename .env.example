# Copy to .env beside compose.yaml. Docker Compose reads it when building the site.
# The API does not use this file. Put DATABASE_URL, AUTH0_DOMAIN, AUTH0_AUDIENCE,
# CORS_ORIGINS, and GEMINI_API_KEY in backend/.env.

VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# Leave empty so the browser calls this same host. Nginx forwards the API paths.
VITE_API_URL=
